{
  "name": "presenta-pdf",
  "version": "2.0.0-beta.1",
  "private": false,
  "description": "Conversor local de presentaciones publicadas Genially y Google Slides a PDF",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check server.js && node --check src/converter.js && node --check public/app.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.56.1",
    "sharp": "^0.34.4"
  },
  "license": "MIT",
  "keywords": [
    "genially",
    "google-slides",
    "pdf",
    "playwright",
    "offline-local",
    "presentations"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gzluis/presenta-pdf-studio.git"
  }
}
